# Host that middleware.ts routes into the internal app surface. Defaults to
# app.farrellelectric.com when unset; local dev uses app.localhost:3000.
NEXT_PUBLIC_APP_HOST=

# App auth (NextAuth v5, Credentials only — no email provider). Required at
# runtime for sign-in to work; unset means the app builds/runs but no one can
# log in. Generate NEXTAUTH_SECRET with `openssl rand -base64 32`.
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Admin login seed. Never store the plaintext password — generate the hash
# with `npm run hash-password -- '<password>'`. Used both by the Prisma seed
# script (npm run db:seed) and, with no DATABASE_URL, to seed the same admin
# identity into the in-memory repo — login works identically either way.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Postgres (Neon). Leave both unset to run the app on the in-memory repo —
# lib/app/repo/ falls back automatically and nothing throws. DATABASE_URL is
# the pooled connection string used at runtime; DIRECT_URL is the direct
# connection Prisma Migrate needs (Neon: same DB, non-pooled port/host).
DATABASE_URL=
DIRECT_URL=

# Main marketing domain. Customer-facing links (the public quote-link route,
# and the publicQuoteUrl sent in outbound GHL events) resolve against this,
# never the app host. Defaults to https://www.farrellelectric.com when unset.
NEXT_PUBLIC_SITE_URL=

# GHL (GoHighLevel) webhook signal-and-sync. Outbound is per entity:
# lib/ghl/dispatch.ts routes lead.* / quote.* / job.* events to the matching
# URL below. Each resolves independently; unset means that entity's dispatches
# log and no-op instead of firing (so lead can go live while job is
# unconfigured). Inbound: app/api/webhooks/ghl verifies the
# x-ghl-webhook-secret header against GHL_WEBHOOK_SECRET; unset means every
# inbound callback is rejected (401 — no secret configured, nothing is
# trusted). No code changes to go live.
GHL_WEBHOOK_URL_LEAD=
GHL_WEBHOOK_URL_QUOTE=
GHL_WEBHOOK_URL_JOB=
GHL_WEBHOOK_SECRET=

# Lead-form bot protection. The honeypot, time-to-submit and validation guards
# need no config. Cloudflare Turnstile is OFF unless BOTH keys are set (one
# without the other stays off). Keep unset unless bots adapt; the site key is
# public and inlined at build time, so enabling it needs a redeploy.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
